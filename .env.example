SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///instance/diabetes.db

# Owner-only access codes for staff portals (change before deployment)
OWNER_ADMIN_ACCESS_CODE=admin2026
OWNER_DOCTOR_ACCESS_CODE=doctor2026

# Gmail (or another SMTP mailbox) used to send registration codes.
# For Gmail, create an App Password and paste it as MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
